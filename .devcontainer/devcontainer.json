{
    "name": "Race Game Build Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // VS Codeと拡張機能を一般ユーザーで実行する
    // Claude Codeのroot権限エラーを回避する
    "remoteUser": "emscripten",

    // Linux ネイティブ版のゲームウィンドウを表示するための軽量デスクトップ
    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {}
    },

    // コンテナ内で有効化するVS Code拡張機能と設定
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "twxs.cmake",
                "ms-vscode.cmake-tools",
                "ms-vscode.wasm-dwarf-debugging",
                "GitHub.copilot"
            ],
            "settings": {
                // Claude Codeの権限確認をスキップできるようにする
                "claudeCode.allowDangerouslySkipPermissions": true,

                // Claude Codeの初期権限モード
                "claudeCode.initialPermissionMode": "bypassPermissions"
            }
        }
    },

    // 8080: ブラウザ版を配信するWebサーバー
    // 6080: Linux ネイティブ版の画面を見るためのデスクトップ
    "forwardPorts": [8080, 6080],
    "runArgs": [
        "--publish", "8080:8080",
        "--publish", "6080:6080"
    ],
    "portsAttributes": {
        "8080": {
            "label": "ブラウザ版のWebサーバー"
        },
        "6080": {
            "label": "Linux版の画面（noVNC）"
        }
    },

    // DISPLAY: ネイティブ版のウィンドウ表示
    // SDL_AUDIODRIVER: 音声デバイスの代わりにダミーを使用
    "remoteEnv": {
        "DISPLAY": ":1",
        "SDL_AUDIODRIVER": "dummy"
    },

    "postCreateCommand": "echo 'Race Game environment is ready!'"
}